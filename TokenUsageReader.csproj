<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TokenUsageReader</RootNamespace>
    <AssemblyName>TokenUsageReader</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Exe icon (Explorer, taskbar, Start); the tray keeps its live percentage icon. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Strings.resx is English: no satellite lookup for it; Italian ships as it\TokenUsageReader.resources.dll. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- `dotnet publish -c Release` produces a single self-contained, compressed .exe (no .NET needed on the target).
       The README lists the overrides for the uncompressed and framework-dependent variants. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <!-- Compression is only allowed for self-contained bundles (NETSDK1176), so a framework-dependent publish drops it. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile Condition="'$(EnableCompressionInSingleFile)' == ''">true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
